<!doctype html>
<html lang="es-AR" class="scroll-smooth">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0950F6" />
  <title>Navegador Modular — Envíos DosRuedas</title>

  <!-- Google Fonts Oficiales: Outfit, Anton, Bebas Neue, Geist Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Anton&family=Bebas+Neue&family=Geist+Mono:wght@400;500;600;700&family=Outfit:wght@300;400;500;600;700&display=swap"
    rel="stylesheet" />

  <style>
    /* ========================================================================
     * VARIABLES Y TOKENS (SISTEMA DE DISEÑO HERO_PARA_ADAPTAR + DOSRUEDAS)
     * ======================================================================== */
    :root {
      color-scheme: light;
      --blue: #0950f6;
      --blue-deep: #073bc2;
      --blue-darker: #062f96;
      --blue-surface: #e6eefe;
      --yellow: #ffec01;
      --yellow-soft: #fff45c;
      --white: #ffffff;
      --ink: #071536;
      --muted: rgba(255, 255, 255, 0.84);
      --border-subtle: rgba(255, 255, 255, 0.22);

      --font-display: "Anton", Impact, sans-serif;
      --font-subhead: "Bebas Neue", Impact, sans-serif;
      --font-body: "Outfit", Arial, sans-serif;
      --font-mono: "Geist Mono", monospace;

      --pad: clamp(16px, 4vw, 56px);
      --header-h: 82px;
      --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
      --shadow-dropdown: 0 20px 48px -8px rgba(7, 21, 54, 0.45);
      --shadow-cta: 0 8px 24px rgba(255, 236, 1, 0.32);
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: var(--blue);
      color: var(--white);
      font-family: var(--font-body);
      min-height: 140vh;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font: inherit;
      background: none;
      border: none;
      cursor: pointer;
      color: inherit;
    }

    /* ========================================================================
     * COMPONENTE: SITE-HEADER
     * ======================================================================== */
    .site-header {
      position: sticky;
      top: 0;
      left: 0;
      right: 0;
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      min-height: var(--header-h);
      padding: 12px var(--pad);
      background: rgba(9, 80, 246, 0.94);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border-subtle);
      transition: background 0.28s ease, min-height 0.28s ease, box-shadow 0.28s ease, border-color 0.28s ease;
    }

    .site-header.scrolled {
      background: rgba(7, 59, 194, 0.98);
      min-height: 70px;
      box-shadow: 0 12px 36px rgba(7, 21, 54, 0.28);
      border-bottom-color: rgba(255, 255, 255, 0.14);
    }

    /* --- BRAND / LOGO CON LOGO.WEBP --- */
    .brand {
      display: inline-flex;
      flex: 0 0 auto;
      align-items: center;
      gap: 12px;
      color: var(--white);
      text-decoration: none;
      user-select: none;
    }

    .brand-logo-img {
      width: 44px;
      height: 44px;
      object-fit: contain;
      filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.25));
      transition: transform 0.2s var(--ease-out);
    }

    .brand:hover .brand-logo-img {
      transform: scale(1.05);
    }

    .brand-name {
      display: block;
      font: 22px/0.92 var(--font-display);
      letter-spacing: -0.015em;
      text-transform: uppercase;
    }

    .brand-name small {
      display: block;
      margin-top: 5px;
      color: var(--yellow);
      font: 9px/1.2 var(--font-mono);
      letter-spacing: 0.12em;
      font-weight: 600;
    }

    /* --- NAVEGACIÓN PRINCIPAL (DESKTOP) --- */
    .primary-nav {
      display: flex;
      align-items: center;
      gap: clamp(14px, 2vw, 28px);
    }

    @media (max-width: 1080px) {
      .primary-nav {
        display: none;
      }
    }

    .nav-item {
      position: relative;
    }

    .nav-link,
    .dropdown-trigger {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 12px;
      border-radius: 8px;
      color: rgba(255, 255, 255, 0.92);
      font: 16px/1 var(--font-subhead);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      transition: color 160ms ease, background 160ms ease;
    }

    .nav-link:hover,
    .dropdown-trigger:hover,
    .nav-item:focus-within>.dropdown-trigger {
      color: var(--yellow);
      background: rgba(255, 255, 255, 0.08);
    }

    .chevron-icon {
      width: 14px;
      height: 14px;
      transition: transform 0.2s var(--ease-out);
      stroke-width: 2.5;
    }

    .nav-item:hover .chevron-icon,
    .nav-item:focus-within .chevron-icon,
    .dropdown-trigger[aria-expanded="true"] .chevron-icon {
      transform: rotate(180deg);
    }

    /* --- MENÚS DESPLEGABLES (DROPDOWNS) --- */
    .dropdown-menu {
      position: absolute;
      top: calc(100% + 4px);
      left: 0;
      min-width: 250px;
      background: var(--blue-deep);
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 14px;
      padding: 8px;
      box-shadow: var(--shadow-dropdown);
      opacity: 0;
      visibility: hidden;
      transform: translateY(8px);
      transition: opacity 0.2s var(--ease-out), transform 0.2s var(--ease-out), visibility 0.2s;
      z-index: 100;
    }

    .nav-item:hover .dropdown-menu,
    .nav-item:focus-within .dropdown-menu {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .dropdown-link {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 12px;
      border-radius: 8px;
      color: var(--white);
      font: 14px var(--font-body);
      font-weight: 500;
      transition: background 150ms ease, color 150ms ease, transform 150ms ease;
    }

    .dropdown-link:hover {
      background: rgba(255, 255, 255, 0.12);
      color: var(--yellow);
      transform: translateX(3px);
    }

    .dropdown-icon-pill {
      width: 28px;
      height: 28px;
      flex: 0 0 28px;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--yellow);
    }

    .dropdown-link:hover .dropdown-icon-pill {
      background: var(--yellow);
      color: var(--blue);
    }

    .dropdown-icon-pill svg {
      width: 15px;
      height: 15px;
    }

    /* --- ACCIONES DERECHA (TELÉFONO + CTA + TOGGLE MÓVIL) --- */
    .header-actions {
      display: flex;
      flex: 0 0 auto;
      align-items: center;
      gap: 14px;
    }

    .header-phone {
      display: none;
      align-items: center;
      gap: 8px;
      color: var(--white);
      font: 14px/1 var(--font-mono);
      font-weight: 600;
      letter-spacing: 0.04em;
      padding: 8px 12px;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.15);
      background: rgba(255, 255, 255, 0.06);
      transition: all 180ms ease;
    }

    @media (min-width: 1240px) {
      .header-phone {
        display: inline-flex;
      }
    }

    .header-phone:hover {
      background: rgba(255, 255, 255, 0.15);
      border-color: var(--yellow);
      color: var(--yellow);
    }

    .header-phone svg {
      width: 15px;
      height: 15px;
      color: var(--yellow);
    }

    /* Botón CTA con disco y flecha (firma visual canónica) */
    .header-cta {
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      min-height: 48px;
      padding: 0 8px 0 18px;
      border: 1px solid var(--yellow);
      border-radius: 999px;
      background: var(--yellow);
      color: var(--blue);
      font: 17px/1 var(--font-subhead);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      box-shadow: var(--shadow-cta);
      transition: transform 180ms ease, background 180ms ease, box-shadow 180ms ease;
    }

    .header-cta:hover {
      transform: translateY(-2px);
      background: var(--yellow-soft);
      box-shadow: 0 10px 28px rgba(255, 236, 1, 0.45);
    }

    .arrow-disc {
      display: grid;
      width: 32px;
      height: 32px;
      flex: 0 0 32px;
      place-items: center;
      border-radius: 50%;
      background: var(--blue);
      color: var(--yellow);
      transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease;
    }

    .header-cta:hover .arrow-disc {
      transform: rotate(-45deg);
      background: var(--ink);
    }

    .arrow-disc svg {
      width: 16px;
      height: 16px;
      stroke-width: 2.5;
    }

    /* Botón menú hamburguesa móvil */
    .menu-toggle {
      display: none;
      width: 44px;
      height: 44px;
      padding: 9px;
      border: 1px solid rgba(255, 255, 255, 0.4);
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.08);
      color: var(--white);
      align-items: center;
      justify-content: center;
      transition: background 0.2s, border-color 0.2s;
    }

    @media (max-width: 1080px) {
      .menu-toggle {
        display: inline-flex;
      }
    }

    .menu-toggle:hover {
      background: rgba(255, 255, 255, 0.2);
      border-color: var(--yellow);
      color: var(--yellow);
    }

    .menu-toggle svg {
      width: 22px;
      height: 22px;
    }

    /* --- MOBILE DRAWER / NAVEGACIÓN MÓVIL DESLIZANTE --- */
    .mobile-overlay {
      position: fixed;
      inset: 0;
      z-index: 2000;
      background: rgba(7, 21, 54, 0.75);
      backdrop-filter: blur(8px);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.28s ease, visibility 0.28s;
    }

    .mobile-overlay.is-active {
      opacity: 1;
      visibility: visible;
    }

    .mobile-drawer-box {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: 86%;
      max-width: 360px;
      background: var(--blue-deep);
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 20px;
      overflow-y: auto;
      transform: translateX(100%);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: -12px 0 40px rgba(0, 0, 0, 0.45);
      border-left: 1px solid rgba(255, 255, 255, 0.15);
    }

    .mobile-overlay.is-active .mobile-drawer-box {
      transform: translateX(0);
    }

    .drawer-top-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(255, 255, 255, 0.15);
      padding-bottom: 16px;
    }

    .drawer-close-btn {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      color: var(--white);
    }

    .drawer-close-btn:hover {
      background: var(--yellow);
      color: var(--blue);
    }

    .mobile-nav-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .mobile-nav-heading {
      font: 12px var(--font-mono);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--yellow);
      margin-top: 14px;
      margin-bottom: 4px;
      padding-left: 8px;
    }

    .mobile-nav-link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 11px 14px;
      border-radius: 10px;
      font: 16px var(--font-subhead);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--white);
      transition: background 150ms, color 150ms;
    }

    .mobile-nav-link:hover {
      background: rgba(255, 255, 255, 0.12);
      color: var(--yellow);
    }

    .mobile-footer-box {
      margin-top: auto;
      padding-top: 20px;
      border-top: 1px solid rgba(255, 255, 255, 0.15);
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    /* Focus visible accesible */
    a:focus-visible,
    button:focus-visible {
      outline: 3px solid var(--yellow);
      outline-offset: 3px;
    }
  </style>
</head>

