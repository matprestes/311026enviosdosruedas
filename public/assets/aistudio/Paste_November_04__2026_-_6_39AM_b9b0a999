<!doctype html>
<html lang="es-AR" class="scroll-smooth">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0950F6" />
  <meta name="description"
    content="Mensajería y logística e-commerce en Mar del Plata. Envíos en el día con flota propia. Llegamos a toda la ciudad y los repartidores son nuestros, sin tercerizar." />
  <title>Envíos DosRuedas | El motor de tu última milla en Mar del Plata</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Anton&family=Anton+SC&family=Bebas+Neue&family=Geist+Mono:wght@400;500;600&family=Outfit:wght@300;400;500;600;700&display=swap"
    rel="stylesheet" />
  <style>
    :root {
      color-scheme: light;
      /* Paleta cromática canónica de hero-animado.html */
      --color-brand-blue-50: #e6eefe;
      --color-brand-blue-100: #bacefd;
      --color-brand-blue-200: #8eaffb;
      --color-brand-blue-300: #628ff9;
      --color-brand-blue-400: #3570f8;
      --color-brand-blue-500: #0950f6;
      --color-brand-blue-600: #073bc2;
      --color-brand-yellow-50: #fffde6;
      --color-brand-yellow-100: #fffab8;
      --color-brand-yellow-200: #fff78a;
      --color-brand-yellow-300: #fff45c;
      --color-brand-yellow-400: #fff12e;
      --color-brand-yellow-500: #ffec01;
      --color-brand-yellow-600: #e6d400;
      --color-white: #ffffff;
      --color-ink: #071536;
      --color-muted: rgba(255, 255, 255, 0.86);

      /* Tipografías */
      --font-display: "Anton SC", "Anton", Impact, sans-serif;
      --font-subhead: "Bebas Neue", sans-serif;
      --font-body: "Outfit", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --font-mono: "Geist Mono", monospace;

      /* Sombras y transiciones */
      --shadow-accent-sm: 0 2px 6px rgba(255, 236, 1, 0.18);
      --shadow-cta-glow: 0 0 28px rgba(255, 236, 1, 0.45), 0 8px 24px rgba(9, 80, 246, 0.18);
      --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
      --duration-ui: 180ms;

      /* Espaciado responsivo del diseño de hero_para_adaptar.html */
      --pad: clamp(20px, 5.2vw, 82px);
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      min-width: 320px;
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background-color: var(--color-brand-blue-500);
      color: var(--color-white);
      font-family: var(--font-body);
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font: inherit;
      background: none;
      border: none;
    }

    ::selection {
      background: var(--color-brand-yellow-500);
      color: var(--color-brand-blue-500);
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .skip-link {
      position: absolute;
      z-index: 50;
      top: -60px;
      left: 16px;
      padding: 12px 18px;
      background: var(--color-brand-yellow-500);
      color: var(--color-brand-blue-500);
      font: 18px var(--font-subhead);
      letter-spacing: 0.05em;
      text-transform: uppercase;
      border-radius: 6px;
      font-weight: 700;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
      transition: top 180ms var(--ease-out);
    }

    .skip-link:focus {
      top: 14px;
      outline: 3px solid var(--color-white);
      outline-offset: 2px;
    }

    /* ==========================================================================
         HERO WRAPPER & BACKGROUND PROCEDURAL
         ========================================================================== */
    .hero {
      position: relative;
      isolation: isolate;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 100svh;
      overflow: hidden;
      background-color: var(--color-brand-blue-500);
      padding-top: 86px;
    }

    /* Fondo canónico procedural de hero-animado.html */
    .procedural-bg {
      position: absolute;
      inset: 0;
      pointer-events: none;
      user-select: none;
      overflow: hidden;
      z-index: -2;
    }

    .canonical-gradient {
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, #0950f6 0%, #0950f6 55%, #3570f8 100%);
    }

    .radial-glow-1 {
      position: absolute;
      top: -8rem;
      left: -8rem;
      width: 32rem;
      height: 32rem;
      border-radius: 9999px;
      background: radial-gradient(circle, rgba(9, 80, 246, 0.35) 0%, rgba(9, 80, 246, 0.18) 50%, transparent 70%);
      filter: blur(80px);
    }

    .radial-glow-2 {
      position: absolute;
      top: 22%;
      right: -8rem;
      width: 38rem;
      height: 38rem;
      border-radius: 9999px;
      background: radial-gradient(circle, rgba(255, 236, 1, 0.22) 0%, rgba(255, 236, 1, 0.06) 45%, transparent 70%);
      filter: blur(90px);
    }

    .radial-glow-3 {
      position: absolute;
      bottom: -10rem;
      left: 28%;
      width: 35rem;
      height: 35rem;
      border-radius: 9999px;
      background: radial-gradient(circle, rgba(9, 80, 246, 0.4) 0%, transparent 70%);
      filter: blur(100px);
    }

    .procedural-grid {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0.08;
    }

    .route-art {
      position: absolute;
      z-index: -1;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0.22;
      pointer-events: none;
    }

    @keyframes pulse-subtle {

      0%,
      100% {
        opacity: 1;
      }

      50% {
        opacity: 0.6;
      }
    }

    .animate-artery {
      animation: pulse-subtle 3s ease-in-out infinite;
    }

    /* Anillo concéntrico sutil de fondo */
    .hero::after {
      content: "";
      position: absolute;
      z-index: -1;
      top: 12%;
      right: 8%;
      width: min(48vw, 680px);
      aspect-ratio: 1;
      border: 1px solid rgba(255, 236, 1, 0.2);
      border-radius: 50%;
      box-shadow:
        0 0 0 34px rgba(255, 236, 1, 0.035),
        0 0 0 86px rgba(255, 236, 1, 0.02);
      pointer-events: none;
    }

    /* ==========================================================================
       OPTIMIZED HEADER (propuestas/pruebas/home/optimized-header.html)
       ========================================================================== */
    header#optimized-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 50;
      width: 100%;
      color: var(--color-white);
      background-color: var(--color-brand-blue-500);
      padding: 0.875rem 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      transition: background-color 0.3s ease, padding 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }

    header#optimized-header.scrolled {
      background-color: rgba(9, 80, 246, 0.95);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      box-shadow: 0 16px 40px rgba(9, 80, 246, 0.18);
      border-bottom-color: rgba(255, 255, 255, 0.18);
      padding: 0.625rem 0;
    }

    .header-inner {
      max-width: 84rem;
      margin: 0 auto;
      padding: 0 var(--pad);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.25rem;
    }

    /* Logo Textual y Marca */
    .brand-logo-text {
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      color: var(--color-white);
      user-select: none;
      flex-shrink: 0;
    }

    .brand-logo-wrap {
      position: relative;
      width: 40px;
      height: 40px;
      flex: 0 0 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 10px;
      background: rgba(255, 255, 255, 0.12);
      padding: 4px;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
      transition: transform 300ms var(--ease-out);
    }

    .brand-logo-text:hover .brand-logo-wrap {
      transform: scale(1.06) rotate(4deg);
    }

    .brand-logo-img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.25));
    }

    .brand-title {
      font-family: var(--font-display);
      font-size: 1.5rem;
      line-height: 1;
      text-transform: uppercase;
      letter-spacing: -0.025em;
      display: flex;
      flex-direction: column;
    }

    @media (min-width: 640px) {
      .brand-title {
        flex-direction: row;
        gap: 0.35rem;
        font-size: 1.75rem;
      }
    }

    .brand-title-yellow {
      color: var(--color-brand-yellow-500);
    }

    /* Desktop Navigation */
    .desktop-nav {
      display: none;
      align-items: center;
      gap: 0.35rem;
    }

    @media (min-width: 1024px) {
      .desktop-nav {
        display: flex;
      }
    }

    .nav-item-wrapper {
      position: relative;
    }

    .nav-link,
    .nav-dropdown-btn {
      padding: 0.5rem 0.875rem;
      border-radius: 0.75rem;
      font-size: 0.95rem;
      font-family: var(--font-subhead);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      text-decoration: none;
      color: var(--color-white);
      background: transparent;
      border: 1px solid transparent;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      transition: all var(--duration-ui) var(--ease-out);
    }

    .nav-link:hover,
    .nav-dropdown-btn:hover {
      color: var(--color-brand-yellow-500);
      background-color: rgba(0, 0, 0, 0.15);
    }

    .nav-link.active,
    .nav-dropdown-btn.active {
      color: var(--color-brand-yellow-500);
      background-color: rgba(0, 0, 0, 0.2);
      border-color: rgba(255, 236, 1, 0.3);
    }

    .chevron-icon {
      width: 1rem;
      height: 1rem;
      transition: transform 0.2s ease;
    }

    .nav-item-wrapper:hover .chevron-icon,
    .nav-dropdown-btn[aria-expanded="true"] .chevron-icon {
      transform: rotate(180deg);
    }

    /* Dropdown Menus */
    .dropdown-panel {
      position: absolute;
      top: 100%;
      left: 0;
      padding-top: 0.5rem;
      width: 16.5rem;
      z-index: 50;
      display: none;
      transform-origin: top left;
      animation: dropdownEnter 0.2s cubic-bezier(0.23, 1, 0.32, 1);
    }

    .nav-item-wrapper:hover .dropdown-panel,
    .nav-item-wrapper:focus-within .dropdown-panel {
      display: block;
    }

    @keyframes dropdownEnter {
      from {
        opacity: 0;
        transform: translateY(4px) scale(0.97);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .dropdown-card {
      background-color: var(--color-brand-blue-500);
      border-radius: 1rem;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.45);
      border: 1px solid rgba(255, 255, 255, 0.18);
      padding: 0.625rem 0.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .dropdown-sublink {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.5rem 0.75rem;
      border-radius: 0.75rem;
      text-decoration: none;
      color: var(--color-white);
      font-family: var(--font-subhead);
      font-size: 0.95rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      border: 1px solid transparent;
      transition: all var(--duration-ui) var(--ease-out);
    }

    .dropdown-sublink:hover {
      color: var(--color-brand-yellow-500);
      background-color: rgba(0, 0, 0, 0.18);
    }

    .dropdown-sublink-icon {
      width: 1.75rem;
      height: 1.75rem;
      border-radius: 0.5rem;
      background-color: rgba(255, 255, 255, 0.1);
      color: var(--color-brand-blue-50);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: background-color 0.2s, color 0.2s;
    }

    .dropdown-sublink:hover .dropdown-sublink-icon {
      background-color: var(--color-brand-yellow-500);
      color: var(--color-brand-blue-500);
    }

    .dropdown-sublink-icon svg {
      width: 1rem;
      height: 1rem;
      stroke-width: 2.2;
    }

    /* Actions Right (Teléfono + Cotizador) */
    .header-actions-desktop {
      display: none;
      align-items: center;
      gap: 1.25rem;
      flex-shrink: 0;
    }

    @media (min-width: 1024px) {
      .header-actions-desktop {
        display: flex;
      }
    }

    .phone-link-header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--color-white);
      text-decoration: none;
      font-family: var(--font-mono);
      font-size: 0.95rem;
      font-weight: 700;
      transition: color var(--duration-ui) var(--ease-out);
    }

    .phone-link-header:hover {
      color: var(--color-brand-yellow-500);
    }

    .phone-link-header svg {
      width: 1rem;
      height: 1rem;
      color: var(--color-brand-yellow-500);
    }

    /* CTA Nested Pill Outline */
    .cta-pill-header {
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      border-radius: 9999px;
      font-family: var(--font-subhead);
      font-size: 0.95rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      text-decoration: none;
      padding: 0.45rem 1.15rem;
      min-height: 44px;
      border: 1px solid rgba(255, 255, 255, 0.45);
      color: var(--color-white);
      transition: all var(--duration-ui) var(--ease-out);
    }

    .cta-pill-header:hover {
      background-color: rgba(255, 255, 255, 0.12);
      border-color: var(--color-white);
    }

    .cta-pill-icon {
      width: 1.75rem;
      height: 1.75rem;
      border-radius: 9999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: var(--color-brand-yellow-500);
      transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
    }

    .cta-pill-header:hover .cta-pill-icon {
      background-color: var(--color-brand-yellow-500);
      color: var(--color-brand-blue-500);
      transform: translateX(3px);
    }

    /* Mobile Header Controls */
    .mobile-controls {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    @media (min-width: 1024px) {
      .mobile-controls {
        display: none;
      }
    }

    .btn-mobile-round {
      width: 42px;
      height: 42px;
      border-radius: 0.75rem;
      background-color: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: var(--color-white);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      text-decoration: none;
      transition: background-color 0.2s, color 0.2s;
    }

    .btn-mobile-round:hover {
      background-color: rgba(255, 255, 255, 0.18);
      color: var(--color-brand-yellow-500);
    }

    .btn-mobile-round svg {
      width: 1.25rem;
      height: 1.25rem;
    }

    /* Mobile Nav Drawer */
    .mobile-nav-drawer {
      position: fixed;
      inset: 0;
      background-color: rgba(7, 21, 54, 0.65);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      z-index: 100;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
    }

    .mobile-nav-drawer.is-open {
      opacity: 1;
      pointer-events: auto;
    }

    .mobile-nav-content {
      position: absolute;
      top: 0;
      right: 0;
      width: min(88vw, 360px);
      height: 100%;
      background-color: var(--color-brand-blue-500);
      border-left: 1px solid rgba(255, 255, 255, 0.18);
      box-shadow: -10px 0 30px rgba(0, 0, 0, 0.4);
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      overflow-y: auto;
      transform: translateX(100%);
      transition: transform 0.3s cubic-bezier(0.23, 1, 0.32, 1);
    }

    .mobile-nav-drawer.is-open .mobile-nav-content {
      transform: translateX(0);
    }

    .mobile-nav-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(255, 255, 255, 0.15);
      padding-bottom: 1rem;
    }

    .mobile-nav-links {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .mobile-nav-link {
      font-family: var(--font-subhead);
      font-size: 1.25rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-white);
      text-decoration: none;
      padding: 0.35rem 0;
    }

    .mobile-nav-link.active,
    .mobile-nav-link:hover {
      color: var(--color-brand-yellow-500);
    }

    .mobile-nav-group {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      padding: 0.5rem 0;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .mobile-group-title {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-brand-yellow-500);
      margin-bottom: 0.25rem;
    }

    .mobile-sublink {
      font-family: var(--font-body);
      font-size: 0.95rem;
      color: rgba(255, 255, 255, 0.85);
      text-decoration: none;
      padding: 0.25rem 0;
      transition: color 0.15s, padding-left 0.15s;
    }

    .mobile-sublink:hover {
      color: var(--color-white);
      padding-left: 4px;
    }

    .mobile-nav-cta {
      margin-top: auto;
      padding-top: 1rem;
    }

    /* ==========================================================================
         HERO MAIN (Grid de 2 columnas según hero_para_adaptar.html)
         ========================================================================== */
    .hero-main {
      position: relative;
      z-index: 10;
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(360px, 0.85fr);
      align-items: center;
      gap: clamp(28px, 4.2vw, 68px);
      width: min(100%, 1580px);
      min-width: 0;
      margin: 0 auto;
      padding: clamp(38px, 6vh, 76px) var(--pad) clamp(30px, 4.5vh, 60px);
    }

    .hero-copy {
      position: relative;
      z-index: 2;
      min-width: 0;
      padding-left: clamp(0px, 1vw, 16px);
    }

    /* Eyebrow con textos y estilos de hero-animado.html */
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-bottom: clamp(20px, 2.8vh, 32px);
      padding: 7px 16px;
      transform: rotate(-1deg);
      border: 1px solid var(--color-brand-yellow-500);
      border-radius: 9999px;
      background: var(--color-brand-yellow-500);
      box-shadow: 0 4px 18px rgba(255, 236, 1, 0.28);
      color: var(--color-brand-blue-500);
      font: 14px var(--font-subhead);
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      user-select: none;
      transition: transform var(--duration-ui) var(--ease-out);
    }

    .eyebrow:hover {
      transform: rotate(-1deg) scale(1.02);
    }

    .eyebrow svg {
      width: 14px;
      height: 14px;
      flex-shrink: 0;
      fill: currentColor;
    }

    /* H1 Headline: Textos de hero-animado.html con el diseño editorial de hero_para_adaptar.html */
    h1 {
      max-width: 780px;
      margin: 0;
      color: var(--color-white);
      font: clamp(44px, 5.8vw, 86px) / 0.91 var(--font-display);
      letter-spacing: -0.035em;
      text-transform: uppercase;
    }

    .headline-line {
      display: block;
      width: fit-content;
      max-width: 100%;
      overflow: hidden;
      padding: 0.03em 0.04em 0.06em 0;
    }

    .headline-pill {
      display: table;
      max-width: 100%;
      margin: 0.06em 0 0.12em -0.02em;
      padding: 0.05em 0.22em 0.08em;
      transform: rotate(-1deg);
      border-radius: 9999px;
      background: var(--color-brand-yellow-500);
      box-shadow: 0 0 28px rgba(255, 236, 1, 0.45);
      color: var(--color-brand-blue-500);
      line-height: 0.96;
      white-space: nowrap;
    }

    .glyph {
      display: inline-block;
      transform-origin: 50% 100%;
      will-change: transform;
    }

    /* Deck de texto de hero-animado.html */
    .hero-deck {
      max-width: 620px;
      margin: clamp(20px, 2.4vw, 30px) 0 0;
      color: var(--color-muted);
      font-family: var(--font-body);
      font-size: clamp(16px, 1.35vw, 18px);
      font-weight: 300;
      line-height: 1.65;
    }

    .hero-deck strong {
      color: var(--color-white);
      font-weight: 600;
    }

    /* CTAs */
    .hero-ctas {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 16px 26px;
      margin-top: 30px;
    }

    .button-primary {
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      gap: 28px;
      min-height: 54px;
      padding: 0 9px 0 22px;
      border: 1px solid var(--color-brand-yellow-500);
      border-radius: 9999px;
      background: var(--color-brand-yellow-500);
      color: var(--color-brand-blue-500);
      font: 20px var(--font-subhead);
      font-weight: 700;
      letter-spacing: 0.055em;
      text-transform: uppercase;
      box-shadow: var(--shadow-accent-sm);
      transition:
        transform var(--duration-ui) var(--ease-out),
        background var(--duration-ui) var(--ease-out),
        box-shadow var(--duration-ui) var(--ease-out);
    }

    .button-primary:hover {
      transform: translateY(-2px);
      background: var(--color-brand-yellow-400);
      box-shadow: var(--shadow-cta-glow);
    }

    .button-primary .arrow-disc {
      width: 36px;
      height: 36px;
      flex: 0 0 36px;
    }

    .button-primary .arrow-disc svg {
      width: 17px;
      height: 17px;
    }

    .button-primary:hover .arrow-disc {
      transform: scale(1.08);
    }

    .text-link {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      min-height: 44px;
      border-bottom: 2px solid var(--color-brand-yellow-500);
      color: var(--color-white);
      font: 18px var(--font-subhead);
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      transition: color var(--duration-ui) var(--ease-out), border-color var(--duration-ui) var(--ease-out);
    }

    .text-link:hover {
      color: var(--color-brand-yellow-500);
    }

    .text-link svg {
      width: 16px;
      height: 16px;
      transition: transform var(--duration-ui) var(--ease-out);
    }

    .text-link:hover svg {
      transform: translateX(4px);
    }

    /* Proof bullets debajo de CTAs */
    .hero-proof {
      display: flex;
      flex-wrap: wrap;
      gap: 12px 24px;
      margin-top: 28px;
      color: var(--color-brand-blue-100);
      font: 11px var(--font-mono);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .hero-proof span {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .proof-mark {
      width: 7px;
      height: 7px;
      transform: rotate(45deg);
      background: var(--color-brand-yellow-500);
      box-shadow: 0 0 6px rgba(255, 236, 1, 0.6);
    }

    /* ==========================================================================
         HERO ART (Diseño orbital y mapa de hero_para_adaptar.html con vector limpio)
         ========================================================================== */
    .hero-art {
      position: relative;
      display: grid;
      min-width: 0;
      min-height: min(580px, 62vh);
      place-items: center;
    }

    .orbit {
      position: absolute;
      top: 50%;
      left: 50%;
      width: min(42vw, 510px);
      aspect-ratio: 1;
      transform: translate(-50%, -50%);
      border: 1px solid rgba(255, 236, 1, 0.45);
      border-radius: 50%;
      box-shadow:
        0 0 0 28px rgba(255, 236, 1, 0.04),
        0 0 0 66px rgba(255, 236, 1, 0.025);
      pointer-events: none;
    }

    .orbit::before,
    .orbit::after {
      content: "";
      position: absolute;
      inset: 10%;
      border: 1px dashed rgba(255, 236, 1, 0.4);
      border-radius: 50%;
    }

    .orbit::after {
      inset: 22%;
      border-style: solid;
      opacity: 0.6;
      border-color: rgba(98, 143, 249, 0.4);
    }

    /* Anillos de pulso reactivos */
    .pulse-ring {
      position: absolute;
      top: 48%;
      left: 50%;
      width: 28%;
      aspect-ratio: 1;
      transform: translate(-50%, -50%);
      border: 2px solid rgba(255, 236, 1, 0.7);
      border-radius: 50%;
      pointer-events: none;
      animation: pulse-ring 3.4s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
    }

    .pulse-ring:nth-of-type(2) {
      animation-delay: 1.1s;
    }

    .pulse-ring:nth-of-type(3) {
      animation-delay: 2.2s;
    }

    @keyframes pulse-ring {
      0% {
        opacity: 0.85;
        transform: translate(-50%, -50%) scale(0.65);
      }

      100% {
        opacity: 0;
        transform: translate(-50%, -50%) scale(3.2);
      }
    }

    .map-art-wrapper {
      position: relative;
      z-index: 2;
      width: min(100%, 540px);
      max-height: min(60vh, 560px);
      display: flex;
      align-items: center;
      justify-content: center;
      transform: rotate(-3deg);
      filter: drop-shadow(0 24px 44px rgba(2, 27, 94, 0.42));
      transition: transform 300ms var(--ease-out);
    }

    .map-art-wrapper:hover {
      transform: rotate(-1deg) scale(1.02);
    }

    .map-art {
      width: 100%;
      height: auto;
      max-height: min(60vh, 540px);
      object-fit: contain;
      display: block;
      border-radius: 20px;
    }

    .rider-avatar {
      width: 34px;
      height: 34px;
      flex: 0 0 34px;
      border-radius: 50%;
      object-fit: cover;
      background: var(--color-brand-blue-50);
      border: 2px solid var(--color-brand-yellow-500);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    }

    /* Tarjetas flotantes / chips geográficos */
    .map-chip {
      position: absolute;
      z-index: 4;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      max-width: 220px;
      padding: 10px 14px;
      border: 1px solid var(--color-brand-blue-100);
      border-radius: 12px;
      background: var(--color-white);
      box-shadow: 0 12px 30px rgba(7, 21, 54, 0.25);
      color: var(--color-brand-blue-500);
      user-select: none;
      transition: transform var(--duration-ui) var(--ease-out), box-shadow var(--duration-ui) var(--ease-out);
    }

    .map-chip:hover {
      transform: translateY(-2px) scale(1.03);
      box-shadow: 0 16px 36px rgba(7, 21, 54, 0.3);
    }

    .map-chip svg {
      width: 20px;
      height: 20px;
      flex: 0 0 20px;
      stroke: var(--color-brand-blue-500);
    }

    .map-chip span {
      font: 10.5px/1.25 var(--font-mono);
      color: #4a5c82;
    }

    .map-chip strong {
      display: block;
      margin-bottom: 2px;
      font: 15px/1 var(--font-subhead);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--color-brand-blue-500);
    }

    .map-chip-rider {
      top: 22%;
      left: -3%;
    }

    .map-chip-base {
      bottom: 8%;
      left: -1%;
    }

    .map-chip-delivery {
      top: 10%;
      right: 0;
    }

    .art-caption {
      position: absolute;
      right: 4%;
      bottom: 2%;
      color: var(--color-brand-blue-100);
      font: 9.5px var(--font-mono);
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    /* ==========================================================================
         TICKER DE BENEFICIOS (Diseño de hero_para_adaptar.html con textos de hero-animado)
         ========================================================================== */
    .ticker {
      position: relative;
      z-index: 20;
      overflow: hidden;
      border-top: 1px solid rgba(255, 255, 255, 0.18);
      background: rgba(4, 47, 174, 0.38);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }

    .ticker-track {
      display: flex;
      width: max-content;
      animation: marquee-left 34s linear infinite;
    }

    .ticker:hover .ticker-track,
    .ticker:focus-within .ticker-track {
      animation-play-state: paused;
    }

    @keyframes marquee-left {
      to {
        transform: translateX(-50%);
      }
    }

    .ticker-list {
      display: flex;
      flex: 0 0 auto;
      align-items: center;
      gap: clamp(24px, 3.2vw, 48px);
      margin: 0;
      padding: 14px clamp(18px, 3vw, 42px);
      list-style: none;
    }

    .ticker-list li {
      display: inline-flex;
      align-items: center;
      gap: clamp(24px, 3.2vw, 48px);
      color: var(--color-white);
      font: 16px var(--font-subhead);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .ticker-rhombus {
      width: 7px;
      height: 7px;
      flex: 0 0 7px;
      transform: rotate(45deg);
      border-radius: 1px;
      background: var(--color-brand-yellow-500);
      box-shadow: 0 0 8px rgba(255, 236, 1, 0.7);
    }

    /* Accesibilidad & Focus Visible */
    a:focus-visible,
    button:focus-visible {
      outline: 3px solid var(--color-brand-yellow-500);
      outline-offset: 4px;
    }

    /* ==========================================================================
         RESPONSIVE BREAKPOINTS
         ========================================================================== */
    @media (max-width: 1050px) {
      .hero-main {
        grid-template-columns: minmax(0, 1.1fr) minmax(310px, 0.9fr);
        gap: 24px;
      }

      h1 {
        font-size: clamp(42px, 6.2vw, 70px);
      }
    }

    @media (max-width: 820px) {
      .hero {
        padding-top: 76px;
      }

      .hero-main {
        grid-template-columns: minmax(0, 1fr);
        gap: 18px;
        padding-top: 40px;
        padding-bottom: 36px;
      }

      .hero-copy {
        max-width: 720px;
      }

      h1 {
        max-width: 720px;
        font-size: clamp(46px, 9vw, 80px);
      }

      .hero-deck {
        max-width: 620px;
      }

      .hero-art {
        min-height: min(460px, 68vw);
        margin-top: 14px;
      }

      .orbit {
        width: min(58vw, 440px);
      }

      .map-art-wrapper {
        width: min(80%, 460px);
        max-height: 420px;
      }

      .map-chip-base {
        bottom: 6%;
        left: 6%;
      }

      .map-chip-delivery {
        top: 4%;
        right: 6%;
      }

      .map-chip-rider {
        top: 22%;
        left: 4%;
      }
    }

    @media (max-width: 520px) {
      :root {
        --pad: 18px;
      }

      .hero {
        padding-top: 70px;
      }

      .hero-main {
        padding-top: 28px;
        padding-bottom: 24px;
      }

      .eyebrow {
        margin-bottom: 18px;
        padding: 6px 12px;
        font-size: 12.5px;
      }

      h1 {
        font-size: clamp(38px, 10vw, 52px);
        letter-spacing: -0.04em;
      }

      .hero-deck {
        margin-top: 16px;
        font-size: 15px;
        line-height: 1.55;
      }

      .hero-ctas {
        gap: 12px 18px;
        margin-top: 22px;
      }

      .button-primary {
        min-height: 50px;
        gap: 18px;
        padding-left: 18px;
        font-size: 18.5px;
      }

      .hero-proof {
        gap: 8px 14px;
        margin-top: 20px;
        font-size: 9.5px;
      }

      .hero-art {
        min-height: 330px;
        margin-top: 6px;
      }

      .map-art-wrapper {
        width: min(85%, 360px);
        max-height: 330px;
      }

      .orbit {
        width: min(78vw, 320px);
      }

      .map-chip {
        gap: 8px;
        max-width: 165px;
        padding: 8px 10px;
        border-radius: 10px;
      }

      .map-chip svg {
        width: 17px;
        height: 17px;
        flex-basis: 17px;
      }

      .map-chip span {
        font-size: 8.5px;
      }

      .map-chip strong {
        font-size: 13px;
      }

      .map-chip-base {
        bottom: 2%;
        left: 0;
      }

      .map-chip-delivery {
        top: 0%;
        right: 0;
      }

      .map-chip-rider {
        top: 32%;
        left: 0;
      }

      .rider-avatar {
        width: 26px;
        height: 26px;
        flex-basis: 26px;
      }

      .ticker-list {
        gap: 22px;
        padding: 12px 18px;
      }

      .ticker-list li {
        gap: 22px;
        font-size: 14.5px;
      }

      .hero::after {
        top: 30%;
        right: -30%;
        width: 88vw;
      }
    }

    /* Reducción de movimiento */
    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      *,
      *::before,
      *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
      }

      .glyph {
        transform: none !important;
      }
    }
  </style>
</head>

