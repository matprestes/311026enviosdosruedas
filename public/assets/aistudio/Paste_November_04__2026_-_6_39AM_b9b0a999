  <!-- Animaciones GSAP para reveal tipográfico de alta gama -->
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js" defer></script>
  <script>
    (() => {
      // Header Scroll Handler (de optimized-header.html)
      const header = document.getElementById("optimized-header");
      window.addEventListener("scroll", () => {
        if (window.scrollY > 20) {
          header?.classList.add("scrolled");
        } else {
          header?.classList.remove("scrolled");
        }
      }, { passive: true });

      // Mobile Menu Drawer Handler
      const mobileToggle = document.getElementById("mobile-menu-toggle-opt");
      const mobileDrawer = document.getElementById("mobile-nav-drawer");
      const mobileClose = document.getElementById("mobile-menu-close-btn");

      const toggleDrawer = (open) => {
        mobileDrawer?.classList.toggle("is-open", open);
        mobileDrawer?.setAttribute("aria-hidden", String(!open));
        mobileToggle?.setAttribute("aria-expanded", String(open));
        document.body.style.overflow = open ? "hidden" : "";
      };

      mobileToggle?.addEventListener("click", () => toggleDrawer(true));
      mobileClose?.addEventListener("click", () => toggleDrawer(false));
      mobileDrawer?.addEventListener("click", (e) => {
        if (e.target === mobileDrawer) toggleDrawer(false);
      });
      mobileDrawer?.querySelectorAll("a").forEach(link => {
        link.addEventListener("click", () => toggleDrawer(false));
      });

      // Animación GSAP de entrada de títulos y elementos visuales
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const animateHero = () => {
        if (reducedMotion || !window.gsap) return;

        const glyphs = [];
        document.querySelectorAll("[data-reveal]").forEach(line => {
          const text = line.textContent.trim();
          line.textContent = "";
          [...text].forEach(char => {
            const span = document.createElement("span");
            span.className = "glyph";
            span.textContent = char === " " ? "\u00a0" : char;
            line.append(span);
            glyphs.push(span);
          });
        });

        gsap.fromTo(
          glyphs,
          { yPercent: 115, rotationX: -75, opacity: 0 },
          {
            yPercent: 0,
            rotationX: 0,
            opacity: 1,
            duration: 0.68,
            stagger: 0.016,
            ease: "back.out(1.25)"
          }
        );

        gsap.fromTo(
          ".map-art-wrapper",
          { opacity: 0, y: 22, scale: 0.94 },
          {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.85,
            delay: 0.25,
            ease: "power3.out"
          }
        );

        gsap.fromTo(
          ".map-chip",
          { opacity: 0, y: 14, scale: 0.92 },
          {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.55,
            delay: 0.8,
            stagger: 0.14,
            ease: "power2.out"
          }
        );

        gsap.fromTo(
          ".orbit",
          { opacity: 0, scale: 0.8 },
          {
            opacity: 1,
            scale: 1,
            duration: 1.1,
            delay: 0.3,
            ease: "power2.out"
          }
        );
      };

      if (document.readyState === "complete") {
        animateHero();
      } else {
        window.addEventListener("load", animateHero, { once: true });
      }
    })();
  </script>
